{
  "name": "Go",
  "image": "mcr.microsoft.com/devcontainers/go:1-bookworm",
  "containerEnv": {
    "GOTOOLCHAIN": "auto"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "cmd/chatlog/app.go"
      ]
    },
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  },
  "updateContentCommand": "go mod download",
  "postAttachCommand": {
    "server": "go run ./cmd/chatlog -addr 0.0.0.0:3000"
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    3000
  ]
}
